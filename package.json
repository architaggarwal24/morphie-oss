{
  "name": "morphie",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Morphie: a multi-provider AI workspace with chat, an autonomous agent, documents, memory and a design studio.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cloudflare": "MORPHIE_TEST_CLOUDFLARE=1 vitest run",
    "check:release": "node scripts/release-check.mjs",
    "release:zip": "node scripts/make-release.mjs && node scripts/release-check.mjs morphie.zip",
    "reset-password": "node scripts/reset-password.mjs",
    "export:oss": "node scripts/export-oss.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^1.0.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "motion": "14.1.0",
    "next": "^16.4.3",
    "nodemailer": "^10.1.0",
    "qrcode-generator": "2.0.4",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "mailauth": "7.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "overrides": {
    "postcss": "$postcss",
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
